spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config/include
  specs:
  # package is defined in the workflows inputs.spack-manifest-data-pairs
  - '{{ package }} configurations=MOM6,CICE6,WW3,MOM6-WW3,MOM6-CICE6,CICE6-WW3,MOM6-CICE6-WW3'
  packages:
    all:
      require:
        - '%access_gcc'
  view: false
