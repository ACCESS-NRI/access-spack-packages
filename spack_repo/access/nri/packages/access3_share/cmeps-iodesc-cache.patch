+  ! --- cached PIO decompositions -------------------------------------------
+  ! med_io_write_FB used to build and free a PIO decomposition on every call.
+  ! A mediator restart writes ~15-20 FieldBundles, so that is ~15-20 full
+  ! rearranger schedule builds over the whole mesh across every mediator PET,
+  ! per restart -- and in any configuration whose components share a mesh they
+  ! are all identical. Entries are keyed on everything pio_initdecomp depends
+  ! on: the PIO type, the global dimensions, and this PET's local degrees of
+  ! freedom. Whether a hit is taken is agreed across all PETs with a single
+  ! collective, so a cache lookup can never desynchronise the collective
+  ! pio_initdecomp that follows a miss.
+  integer, parameter             :: med_io_maxiodesc = 8
+  type med_io_iodesc_type
+     logical              :: inuse    = .false.
+     integer              :: piotype  = -1
+     integer              :: ndim     = 0
+     integer              :: gdims(3) = 0
+     integer              :: ns       = -1
+     integer, allocatable :: dof(:)
+     type(io_desc_t)      :: iodesc
+  end type med_io_iodesc_type
+  type(med_io_iodesc_type), save :: med_io_iodesc_cache(med_io_maxiodesc)
+  integer, save                  :: med_io_iodesc_victim = 0
+  integer, save                  :: med_io_iodesc_hits   = 0
+  integer, save                  :: med_io_iodesc_misses = 0
   character(*),parameter         :: u_FILE_u = &
        __FILE__
 
