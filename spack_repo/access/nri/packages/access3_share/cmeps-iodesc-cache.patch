   !===============================================================================
+  !===============================================================================
+  subroutine med_io_get_iodesc(piotype, gdims, dof, iodesc, rc)
+
+    !---------------
+    ! Return a PIO decomposition for (piotype, gdims, dof), reusing a cached one
+    ! when this PET -- and every other PET in the mediator VM -- already has it.
+    !---------------
+
+    use ESMF , only : ESMF_VM, ESMF_VMGetCurrent, ESMF_VMAllReduce, ESMF_REDUCE_MAX
+    use pio  , only : pio_initdecomp, pio_freedecomp
+
+    ! input/output variables
+    integer         , intent(in)  :: piotype   ! pio_real or pio_double
+    integer         , intent(in)  :: gdims(:)  ! global dimensions
+    integer         , intent(in)  :: dof(:)    ! this PET's degrees of freedom
+    type(io_desc_t) , intent(out) :: iodesc    ! io_desc_t is an integer handle, so copying is free
+    integer         , intent(out) :: rc
+
+    ! local variables
+    type(ESMF_VM)          :: vm
+    integer                :: n, ndim, ns, slot
+    integer                :: lhit(2), ghit(2)
+    character(CL)          :: tmpstr
+    character(*),parameter :: subName = '(med_io_get_iodesc) '
+    !---------------------------------------------------------------------------
+
+    rc   = ESMF_SUCCESS
+    ndim = size(gdims)
+    ns   = size(dof)
+
+    if (ndim > size(med_io_iodesc_cache(1)%gdims)) then
+       call shr_log_error(trim(subname)//' ERROR: too many dimensions for cache key', rc=rc)
+       return
+    end if
+
+    ! --- local lookup --------------------------------------------------------
+    lhit(1) = 0
+    do n = 1,med_io_maxiodesc
+       if (.not. med_io_iodesc_cache(n)%inuse)        cycle
+       if (med_io_iodesc_cache(n)%piotype /= piotype) cycle
+       if (med_io_iodesc_cache(n)%ndim    /= ndim)    cycle
+       if (med_io_iodesc_cache(n)%ns      /= ns)      cycle
+       if (any(med_io_iodesc_cache(n)%gdims(1:ndim) /= gdims(1:ndim))) cycle
+       if (ns > 0) then
+          if (any(med_io_iodesc_cache(n)%dof(1:ns) /= dof(1:ns))) cycle
+       end if
+       lhit(1) = n
+       exit
+    end do
+
+    ! --- every PET must agree, or the pio_initdecomp after a miss would hang --
+    ! Send (hit, -hit) and reduce with MAX, so one collective yields both the
+    ! maximum and (negated) the minimum local hit index.
+    lhit(2) = -lhit(1)
+    call ESMF_VMGetCurrent(vm, rc=rc)
+    if (chkerr(rc,__LINE__,u_FILE_u)) return
+    call ESMF_VMAllReduce(vm, lhit(1:2), ghit(1:2), 2, ESMF_REDUCE_MAX, rc=rc)
+    if (chkerr(rc,__LINE__,u_FILE_u)) return
+
+    if (ghit(1) > 0 .and. ghit(1) == -ghit(2)) then
+       ! unanimous hit on the same slot
+       med_io_iodesc_hits = med_io_iodesc_hits + 1
+       iodesc = med_io_iodesc_cache(ghit(1))%iodesc
+       if (dbug_flag > 1) then
+          write(tmpstr,*) subname,' hit slot ',ghit(1),' hits/misses ', &
+               med_io_iodesc_hits, med_io_iodesc_misses
+          call ESMF_LogWrite(trim(tmpstr), ESMF_LOGMSG_INFO)
+       end if
+       return
+    end if
+
+    ! --- miss ----------------------------------------------------------------
+    ! Slot choice must be identical on every PET. Occupancy and the victim
+    ! counter are only ever modified here, which all PETs reach together, so
+    ! "first free, else round-robin" is consistent by construction.
+    slot = 0
+    do n = 1,med_io_maxiodesc
+       if (.not. med_io_iodesc_cache(n)%inuse) then
+          slot = n
+          exit
+       end if
+    end do
+    if (slot == 0) then
+       med_io_iodesc_victim = mod(med_io_iodesc_victim, med_io_maxiodesc) + 1
+       slot = med_io_iodesc_victim
+       call pio_freedecomp(io_subsystem, med_io_iodesc_cache(slot)%iodesc)
+       med_io_iodesc_cache(slot)%inuse = .false.
+    end if
+
+    call pio_initdecomp(io_subsystem, piotype, gdims, dof, med_io_iodesc_cache(slot)%iodesc)
+
+    med_io_iodesc_cache(slot)%piotype       = piotype
+    med_io_iodesc_cache(slot)%ndim          = ndim
+    med_io_iodesc_cache(slot)%gdims         = 0
+    med_io_iodesc_cache(slot)%gdims(1:ndim) = gdims(1:ndim)
+    med_io_iodesc_cache(slot)%ns            = ns
+    if (allocated(med_io_iodesc_cache(slot)%dof)) deallocate(med_io_iodesc_cache(slot)%dof)
+    allocate(med_io_iodesc_cache(slot)%dof(ns))
+    if (ns > 0) med_io_iodesc_cache(slot)%dof(1:ns) = dof(1:ns)
+    med_io_iodesc_cache(slot)%inuse         = .true.
+    med_io_iodesc_misses = med_io_iodesc_misses + 1
+
+    iodesc = med_io_iodesc_cache(slot)%iodesc
+
+    if (dbug_flag > 1) then
+       write(tmpstr,*) subname,' built slot ',slot,' hits/misses ', &
+            med_io_iodesc_hits, med_io_iodesc_misses
+       call ESMF_LogWrite(trim(tmpstr), ESMF_LOGMSG_INFO)
+    end if
+
+  end subroutine med_io_get_iodesc
+
+  !===============================================================================
+  subroutine med_io_finalize(rc)
+
+    !---------------
+    ! Release every cached PIO decomposition. Collective over the mediator PETs.
+    !---------------
+
+    use pio  , only : pio_freedecomp
+
+    ! input/output variables
+    integer, intent(out) :: rc
+
+    ! local variables
+    integer :: n
+    !---------------------------------------------------------------------------
+
+    rc = ESMF_SUCCESS
+
+    do n = 1,med_io_maxiodesc
+       if (med_io_iodesc_cache(n)%inuse) then
+          call pio_freedecomp(io_subsystem, med_io_iodesc_cache(n)%iodesc)
+          med_io_iodesc_cache(n)%inuse = .false.
+       end if
+       if (allocated(med_io_iodesc_cache(n)%dof)) deallocate(med_io_iodesc_cache(n)%dof)
+    end do
+
+    if (maintask) then
+       write(logunit,'(a,i0,a,i0)') ' (med_io_finalize) PIO decomposition cache hits = ', &
+            med_io_iodesc_hits, ', builds = ', med_io_iodesc_misses
+    end if
+
+  end subroutine med_io_finalize
+
